---
// A link to another site. Opens in a new tab and tells screen reader users so.
interface Props {
  href: string;
  class?: string;
}

const { href, class: className } = Astro.props;
---

<a href={href} class={className} target="_blank" rel="noopener noreferrer"
  ><slot /><span class="visually-hidden"> (opens in a new tab)</span></a
>
