---
// Floating "back to top" button. Appears once the visitor scrolls past the
// first screen of the page.
---

<a class="icon-button back-to-top" href="#top" aria-label="Back to top">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 19V5M5 12l7-7 7 7"></path>
  </svg>
</a>

<script>
  const link = document.querySelector('.back-to-top');

  if (link) {
    const update = () => link.classList.toggle('is-visible', window.scrollY > window.innerHeight);
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>
