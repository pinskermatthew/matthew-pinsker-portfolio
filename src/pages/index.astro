---
import { getCollection, getEntry } from 'astro:content';
import BackToTop from '../components/BackToTop.astro';
import ExternalLink from '../components/ExternalLink.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Base from '../layouts/Base.astro';

const profileEntry = await getEntry('profile', 'matthew');
if (!profileEntry) throw new Error('Missing profile entry "matthew" in src/content/profile.yaml');
const profile = profileEntry.data;

const samples = (await getCollection('samples')).sort((a, b) => a.data.order - b.data.order);
---

<Base title={`${profile.name} | Technical Writer`} description={profile.headline}>
  <a class="skip-link" href="#main">Skip to content</a>

  <header id="top" class="site-header">
    <div class="container">
      <a class="brand" href="#top">{profile.name}</a>
      <nav class="site-nav" aria-label="Main">
        <ul>
          <li><a href="#work">Work</a></li>
          <li><a href="#approach">Approach</a></li>
          <li><a href="#skills">Skills</a></li>
          <li><a href="#experience">Experience</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </nav>
      <ThemeToggle />
    </div>
  </header>

  <main id="main">
    <section class="hero" aria-labelledby="about-heading">
      <div class="container">
        <h1 id="about-heading">{profile.name}</h1>
        <p class="headline">{profile.headline}</p>
        <p class="summary">{profile.summary}</p>
        <ul class="hero-links">
          <li><a href="#work">See my work</a></li>
          <li><ExternalLink href={profile.links.linkedin}>Contact me on LinkedIn</ExternalLink></li>
        </ul>
      </div>
    </section>

    <section id="work" class="section" aria-labelledby="work-heading">
      <div class="container">
        <h2 id="work-heading">Selected work</h2>
        {samples.map(({ data }) => (
          <article class="sample">
            <p class="eyebrow">{data.product}</p>
            <h3><ExternalLink href={data.url}>{data.title}</ExternalLink></h3>
            <p>{data.summary}</p>
            <dl>
              <dt>Audience</dt>
              <dd>{data.audience}</dd>
              <dt>My role</dt>
              <dd>{data.role}</dd>
            </dl>
            <ul class="chips" aria-label="Tools">
              {data.tools.map((tool) => <li>{tool}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section id="approach" class="section" aria-labelledby="approach-heading">
      <div class="container">
        <h2 id="approach-heading">How I work with AI</h2>
        <ol class="approach">
          {profile.approach.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="skills" class="section" aria-labelledby="skills-heading">
      <div class="container">
        <h2 id="skills-heading">Skills and tools</h2>
        <div class="skills">
          {profile.skills.map((group) => (
            <div>
              <h3>{group.group}</h3>
              <ul>
                {group.items.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="experience" class="section" aria-labelledby="experience-heading">
      <div class="container">
        <h2 id="experience-heading">Experience</h2>
        {profile.experience.map((job) => (
          <article class="job">
            <h3>{job.company}</h3>
            <p class="meta job-dates">{job.start}–{job.end ?? 'Present'}</p>
            <div class="job-details">
              <p>{job.role}</p>
              {job.note && <p class="note">{job.note}</p>}
            </div>
          </article>
        ))}
        <p class="more-link">
          <ExternalLink href={profile.links.linkedin}>Full work history on LinkedIn</ExternalLink>
        </p>
      </div>
    </section>

    <section id="contact" class="section" aria-labelledby="contact-heading">
      <div class="container">
        <h2 id="contact-heading">Contact</h2>
        <p class="contact-lead">{profile.contactLead}</p>
        <ul class="contact-links">
          <li><ExternalLink href={profile.links.linkedin}>Contact me on LinkedIn</ExternalLink></li>
          {profile.links.github && <li><ExternalLink href={profile.links.github}>GitHub</ExternalLink></li>}
        </ul>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="container">
      <p class="meta">© {new Date().getFullYear()} {profile.name} · Built with Astro and Claude Code</p>
    </div>
  </footer>

  <BackToTop />
</Base>
