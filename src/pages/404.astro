---
// "Lost in space" page, served for any URL that doesn't exist (see
// not_found_handling in wrangler.jsonc). It can be more playful than the main
// page, since visitors only see it after a bad link (docs/design.md).
import ThemeToggle from '../components/ThemeToggle.astro';
import Base from '../layouts/Base.astro';
import { getSiteContent } from '../lib/content';

const { profile } = await getSiteContent();
---

<Base title={`Lost in space | ${profile.name}`} description="This page doesn't exist." noindex>
  <header class="site-header">
    <div class="container">
      <a class="brand" href="/">{profile.name}</a>
      <ThemeToggle />
    </div>
  </header>

  <main id="main" class="not-found">
    <div class="container">
      <svg class="not-found-art" viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <g class="not-found-stars">
          <circle cx="16" cy="22" r="1.2"></circle>
          <circle cx="98" cy="14" r="1.2"></circle>
          <circle cx="108" cy="76" r="1.2"></circle>
          <circle cx="24" cy="96" r="1.2"></circle>
          <circle cx="62" cy="8" r="0.8"></circle>
          <circle cx="8" cy="60" r="0.8"></circle>
        </g>
        <g class="not-found-rocket">
          <g transform="translate(60 60) rotate(35) scale(3.8) translate(-12 -12)" stroke-width="0.55">
            <path d="M12 2.5c2.8 2.6 4 6.3 3.6 12.5H8.4C8 8.8 9.2 5.1 12 2.5z"></path>
            <circle cx="12" cy="9" r="1.6"></circle>
            <path d="M8.4 11.5 5.5 14.5v3l3-2.5M15.6 11.5l2.9 3v3l-3-2.5"></path>
          </g>
        </g>
      </svg>
      <p class="meta">404</p>
      <h1>Lost in space</h1>
      <p class="not-found-text">This page drifted out of orbit, or never existed.</p>
      <p><a href="/">Back to the home page</a></p>
    </div>
  </main>
</Base>
